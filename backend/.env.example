# Copy to .env and fill in. Local dev only needs the OpenRouter key;
# the local embedder, reranker, and vector store run in-process.

# --- LLM (OpenRouter free key works: https://openrouter.ai/keys) ---
OPENROUTER_API_KEY=
# Any OpenRouter model id works. Free models (the :free suffix) cost nothing but
# are rate limited per model, so if one is busy just swap in another :free id.
LLM_MODEL=openai/gpt-oss-120b:free

# --- Embeddings: local (ONNX) for dev, jina for deploy ---
EMBEDDING_PROVIDER=local
# JINA_API_KEY=

# --- Reranker: local (ONNX) for dev, jina for deploy ---
RERANK_PROVIDER=local

# --- Vector store: local (in-process) for dev, pgvector for deploy ---
VECTOR_STORE=local
# DATABASE_URL=postgresql://...supabase...

# --- App ---
CORS_ORIGINS=http://localhost:5173
